generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum CardStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  GENERATED
  PRINTED
  EXPIRED
  REVOKED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String
  role           Role           @default(ADMIN)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Organization {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  logoUrl      String?
  address      String?
  phone        String?
  email        String?
  website      String?
  tagline      String?
  template     String       @default("classic")
  members      Member[]
  cards        IDCard[]
  payments     Payment[]
  users        User[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Member {
  id             String       @id @default(cuid())
  memberNumber   String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  position       String?
  department     String?
  photoUrl       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cards          IDCard[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, memberNumber])
  @@index([organizationId])
}

model IDCard {
  id             String       @id @default(cuid())
  cardNumber     String       @unique
  status         CardStatus   @default(DRAFT)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  designJson     Json?
  frontImageUrl  String?
  backImageUrl   String?
  pdfUrl         String?
  verificationId String       @unique
  issuedAt       DateTime?
  expiresAt      DateTime?
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([verificationId])
}

model Payment {
  id                 String        @id @default(cuid())
  reference          String        @unique
  amount             Int
  currency           String        @default("NGN")
  status             PaymentStatus @default(PENDING)
  provider           String        @default("paystack")
  cardId             String
  card               IDCard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metadata           Json?
  paidAt             DateTime?
  
  // Refund Fields
  refundedAt         DateTime?
  refundedAmount     Int?
  refundReference    String?
  refundReason       String?
  refundedByUserId   String?
  failureReason      String?
  lastEventAt        DateTime?
  
  createdAt          DateTime      @default(now())

  @@index([organizationId])
  @@index([status])
  @@index([refundReference])
}
